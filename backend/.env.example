# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/worksession_tracker

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=12h

# --- Tracking defaults (worker app receives these at punch-in; each is configurable per deployment) ---
DEFAULT_UPDATE_INTERVAL_SEC=60
DEFAULT_DISTANCE_FILTER_M=100
STALE_THRESHOLD_SEC=180

# --- Retention ---
LOCATION_RETENTION_DAYS=90

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Consent ---
CONSENT_POLICY_VERSION=2026-09-v1

# --- Maps (used by dashboard/mobile, not backend, but listed here for one-stop config) ---
# If using MapLibre + open tiles, no key is required (see dashboard/.env.example).
# If using Google Maps instead, set:
# GOOGLE_MAPS_API_KEY=
