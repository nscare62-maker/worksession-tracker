VITE_API_BASE_URL=http://localhost:4000
VITE_WS_BASE_URL=ws://localhost:4000

# Stale threshold shown in the UI; keep in sync with backend STALE_THRESHOLD_SEC
VITE_STALE_THRESHOLD_SEC=180

# MapLibre with free open tiles (no key needed) is the default in src/components/MapView.tsx.
# To use Google Maps instead, provide a key and swap the style loader:
# VITE_GOOGLE_MAPS_API_KEY=
