<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- GeoWorkers Midnight Theme -->
    <style name="Theme.WorkSessionTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/bg_topbar</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_void</item>
        <item name="android:statusBarColor">@color/bg_topbar</item>
        <item name="android:navigationBarColor">@color/bg_void</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash / router activity -->
    <style name="Theme.WorkSessionTracker.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/bg_topbar</item>
        <item name="android:windowBackground">@color/bg_void</item>
        <item name="android:statusBarColor">@color/bg_topbar</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- Compatibility alias -->
    <style name="Theme.WorkSessionTracker.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/bg_topbar</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_void</item>
        <item name="android:statusBarColor">@color/bg_topbar</item>
    </style>

</resources>